{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "BehindReverseProxy": true
  },
  "RateLimiting": {
    "Global": {
      "PermitsPerMinute": 300
    },
    "CreateRoom": {
      "PermitsPerMinute": 20
    },
    "Move": {
      "PermitsPerMinute": 240
    },
    "JoinRoom": {
      "PermitsPerMinute": 5
    }
  },
  "RoomCleanup": {
    "IntervalMinutes": 5
  }
}
